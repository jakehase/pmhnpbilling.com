{
  "description": "PMHNPBILLING canonical redirects",
  "rules": [
    {
      "description": "Force HTTPS",
      "expression": "http.request.scheme eq \"http\"",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://\", http.host, http.request.uri.path, if(len(http.request.uri.query) gt 0, concat(\"?\", http.request.uri.query), \"\"))"
          },
          "preserve_query_string": true
        }
      }
    },
    {
      "description": "Force apex host (remove www)",
      "expression": "lower(http.host) eq \"www.pmhnpbilling.com\"",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://pmhnpbilling.com\", http.request.uri.path, if(len(http.request.uri.query) gt 0, concat(\"?\", http.request.uri.query), \"\"))"
          },
          "preserve_query_string": true
        }
      }
    }
  ]
}
